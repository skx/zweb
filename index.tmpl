<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="30">
<title>Zigbee Devices</title>
<style>
        body {
                font-family: sans-serif;
                background: #181818;
                color: #eee;
                margin: 30px;
        }

        h1 {
                margin-bottom: 25px;
        }

        .group {
                margin-bottom: 40px;
        }

        .grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                gap: 15px;
        }

        .device {
                background: #292929;
                border-radius: 12px;
                padding: 20px;
                text-align: center;
        }

        .name {
                font-size: 17px;
                margin-bottom: 15px;
                overflow-wrap: anywhere;
        }

        .state {
                font-size: 14px;
                margin-bottom: 15px;
        }

        button {
                border: 0;
                border-radius: 8px;
                padding: 12px 25px;
                font-size: 16px;
                cursor: pointer;
                width: 100%;
                color: white;
                background: #555;
        }

        button.on {
                background: #218838;
        }

        button.off {
                background: #b52b37;
        }

        button.unknown {
                background: #555;
        }

        button:hover {
                filter: brightness(1.15);
        }
</style>
</head>
<body>
{{range .Groups}}
<div class="group">
        <h1>{{.Name}}</h1>
        <div class="grid">
        {{range .Devices}}
                <div class="device">

                        <div class="name">{{.Description}}</div>

                        <div style="font-size:12px;color:#999;margin-bottom:12px">
                                {{.Name}}
                        </div>

                        <div class="state">{{.State}}</div>

                        <form method="POST" action="/toggle/{{.Escaped}}">
                                <button class="{{.Class}}" type="submit"
                                        {{if not (or (eq .State "ON") (eq .State "OFF"))}}disabled{{end}}>
                                        {{if eq .State "ON"}}Turn OFF
                                        {{else if eq .State "OFF"}}Turn ON
                                        {{else}}Unknown{{end}}
                                </button>
                        </form>

                </div>
        {{else}}
                <p>No devices found in this group.</p>
        {{end}}
        </div>
</div>
{{end}}
</body>
</html>
